# ── ENVIRONMENT ──────────────────────────────────────────
NODE_ENV=development

# ── SERVER ───────────────────────────────────────────────
PORT=8080

# ── STAGING GATE (Basic Auth — remove in production) ─────
STAGING_USERNAME=admin
STAGING_PASSWORD=your_staging_password

# ── SESSION SECRET ────────────────────────────────────────
SESSION_SECRET=your_long_random_secret_here

# ── LOCAL DATABASE (used when NODE_ENV != production) ─────
LOCAL_DB_HOST=localhost
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=driving_db
LOCAL_DB_PORT=3306

# ── PRODUCTION DATABASE (Hostinger — MySQL is always localhost) ──
PROD_DB_HOST=localhost
PROD_DB_USER=your_hostinger_db_user
PROD_DB_PASSWORD=your_hostinger_db_password
PROD_DB_NAME=your_hostinger_db_name
PROD_DB_PORT=3306

# ── RWANDAPAY ─────────────────────────────────────────────
RWANDAPAY_MERCHANT_ID=your_merchant_id_here
RWANDAPAY_API_KEY=your_api_key_here
RWANDAPAY_BASE_URL=https://api.rwandapay.rw
RWANDAPAY_CALLBACK_URL=https://yourdomain.com/api/payments/callback

# ── PAYPACK ───────────────────────────────────────────────
PAYPACK_CLIENT_ID=your_paypack_client_id
PAYPACK_CLIENT_SECRET=your_paypack_client_secret
PAYPACK_WEBHOOK_SECRET=copy_from_the_paypack_webhook_settings

# ── GMAIL SMTP ────────────────────────────────────────────
SMTP_USER=your_smtp_account@gmail.com
SMTP_PASS=your_smtp_app_password

# ── ERROR ALERT EMAIL (receives crash/payment/DB alerts) ──
ERROR_EMAIL=nzerneste250@gmail.com
ALERT_EMAIL=nzerneste250@gmail.com

# ── ADMIN EMAIL (used for admin login and OTP reset) ──
ADMIN_EMAIL=dotadostationerystore@gmail.com

# ── REPORT EMAIL (receives weekly/monthly/yearly PDF reports) ──
REPORT_EMAIL=your_report_email@gmail.com

# GA4 stays disabled until a real Measurement ID and opt-in consent are configured.
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_DEBUG=false
